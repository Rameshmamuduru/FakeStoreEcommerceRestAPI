<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="API TestSuite" thread-count="2" parallel="tests">
  
  <listeners>
  	<listener class-name="utils.ExtentReporter" />
    <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
  </listeners>
  
  <test name="Product Tests">
    <classes>
      <class name="testcases.ProductTests"/>
    </classes>
  </test> 
  
  <test name="User Tests">
    <classes>
      <class name="testcases.UserTests"/>
    </classes>
  </test>
  
    <test name="Cart Tests">
    <classes>
      <class name="testcases.CartTests"/>
    </classes>
  </test>
  
  
  <test name="Auth Tests">
    <classes>
      <class name="testcases.LoginTests"/>
    </classes>
  </test>
  
    <test name="Schema Tests">
    <classes>
      <class name="testcases.SchemaTests"/>
    </classes>
  </test>
  
  
  <test name="ProductDataDrivenTest Tests">
    <classes>
      <class name="testcases.ProductDataDrivenTest"/>
    </classes>
  </test>
  
  
</suite> 
